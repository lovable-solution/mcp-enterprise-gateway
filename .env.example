# =============================================================================
# Local development environment. Never commit .env.
#
# `make env` creates .env from this file, replacing every __GENERATE__ value with
# a random 256-bit hex secret. On later runs it only ADDS variables that .env is
# missing (re-run it after pulling changes); existing values are never changed.
#
# docker-compose.yml has no fallback credentials: Compose refuses to start when
# a secret below is missing.
# =============================================================================

# --- Secrets (generated) -------------------------------------------------------
POSTGRES_PASSWORD=__GENERATE__
GATEWAY_DB_PASSWORD=__GENERATE__
AGENT_DB_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
# Signs the local development JWTs minted by `make token` (HS256).
GATEWAY_JWT_SECRET=__GENERATE__
# Shared by the gateway and crm-ops: signs/verifies gateway identity assertions.
UPSTREAM_ASSERTION_KEY=__GENERATE__
# Signs approval webhooks (HMAC-SHA256); receivers verify with the same key.
WEBHOOK_HMAC_KEY=__GENERATE__
# Encrypts the operator console's session cookie (which carries the operator's token).
CONSOLE_SESSION_SECRET=__GENERATE__

# --- Agent runtime --------------------------------------------------------------
# Claude API key for the agent runtime (`make agent-run`). Not generated: paste yours.
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---------------------------------------
# Host ports bind to 127.0.0.1 only. The defaults avoid 5432/6379 so the stack can
# run next to a locally installed Postgres or Redis.
# GATEWAY_HOST_PORT=8000
# POSTGRES_HOST_PORT=15432
# REDIS_HOST_PORT=16379
# OTLP_GRPC_HOST_PORT=4317
# OTLP_HTTP_HOST_PORT=4318
# JAEGER_UI_HOST_PORT=16686
# PROMETHEUS_HOST_PORT=9090
# CONSOLE_HOST_PORT=3000

# Gateway: token issuer expected by the gateway (and used by `make token`), and an
# optional receiver for approval webhooks, e.g. a Slack bridge.
# GATEWAY_JWT_ISSUER=http://localhost/dev-idp
# GATEWAY_WEBHOOK_URL=https://hooks.example.internal/mcp-gateway

# One database and owning role per service, created on the first start of an empty
# Postgres volume (changing these later requires `make reset`).
# POSTGRES_SUPERUSER=postgres
# GATEWAY_DB_NAME=mcp_gateway
# GATEWAY_DB_USER=mcp_gateway
# AGENT_DB_NAME=agent_runtime
# AGENT_DB_USER=agent_runtime
