# Copy to backend.hcl (git-ignored), then: terraform init -backend-config=backend.hcl
# The state bucket must be versioned, SSE-KMS encrypted and block public access.
bucket       = "<state-bucket-name>"
key          = "mcp-enterprise-gateway/dev/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "<state-kms-key-arn>"
use_lockfile = true # S3-native state locking (no DynamoDB table)
